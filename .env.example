# Copy to .env and fill in. .env is gitignored — never commit real keys.

APP_ENV=development
LOG_LEVEL=INFO

# Market data. yfinance needs no key; these are for optional upgrades.
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# News / sentiment sources
NEWSAPI_KEY=
FINNHUB_API_KEY=

# LLM used for news summarization + reasoning over signals
ANTHROPIC_API_KEY=

# Local persistence
DATA_DIR=./data/store
CACHE_DIR=./data/cache
CACHE_TTL_SECONDS=900

# Paper trading
PAPER_STARTING_CASH=100000
